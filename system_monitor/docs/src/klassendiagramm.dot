// UML-Klassendiagramm System-Monitor
digraph UML {
    graph [label="UML-Klassendiagramm System-Monitor (Version 2.2)", labelloc=t, fontsize=18, fontname="DejaVu Sans Bold",
           rankdir=TB, nodesep=0.5, ranksep=0.7, bgcolor=white, pad=0.4];
    node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
    edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.8];

    MonitorApp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>MonitorApp</B> (gui.py)</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">- monitor: Monitor<BR ALIGN="LEFT"/>- config_path: Path<BR ALIGN="LEFT"/>- paused: bool<BR ALIGN="LEFT"/>- _last_run: dict[str, float]<BR ALIGN="LEFT"/>- _external: set[str]<BR ALIGN="LEFT"/>- overlay: OverlayWindow | None<BR ALIGN="LEFT"/>- hotkeys: HotkeyListener<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">- _tick()<BR ALIGN="LEFT"/>- _measure(skip_processes)<BR ALIGN="LEFT"/>- _show_snapshot(s: Snapshot)<BR ALIGN="LEFT"/>+ toggle_pause()<BR ALIGN="LEFT"/>+ toggle_overlay()<BR ALIGN="LEFT"/>- _refresh(key, force)<BR ALIGN="LEFT"/>- _update_traffic(counters)<BR ALIGN="LEFT"/>- _show_drives / _show_wlan / _show_bluetooth<BR ALIGN="LEFT"/>+ check_updates()<BR ALIGN="LEFT"/>+ install_updates(all_)<BR ALIGN="LEFT"/>+ open_settings()<BR ALIGN="LEFT"/>+ quit()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    SettingsDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>SettingsDialog</B> (gui.py)</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">- vars: dict[str, StringVar]<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">- _save()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    cli [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#eeeeee"><I>«Modul»</I> <B>cli.py</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ run_cli(monitor, once, updates)<BR ALIGN="LEFT"/>+ render_drives / _traffic / _wlan<BR ALIGN="LEFT"/>   / _bluetooth / _updates(...)<BR ALIGN="LEFT"/>+ render(s, thresholds, history): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Monitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>Monitor</B> (core.py)</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ config: Config<BR ALIGN="LEFT"/>+ collector: SystemCollector<BR ALIGN="LEFT"/>+ alerts: AlertManager<BR ALIGN="LEFT"/>+ csv: CsvWriter | None<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ step(force_processes, skip_processes):<BR ALIGN="LEFT"/>   (Snapshot, list[Alert])<BR ALIGN="LEFT"/>+ apply_config(config: Config)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Config [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>Config</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ interval_s: float<BR ALIGN="LEFT"/>+ cpu/ram/disk_threshold: float<BR ALIGN="LEFT"/>+ hysteresis: float<BR ALIGN="LEFT"/>+ disk_path: str<BR ALIGN="LEFT"/>+ alert_cooldown_s: int<BR ALIGN="LEFT"/>+ top_processes: int<BR ALIGN="LEFT"/>+ csv_logging: bool<BR ALIGN="LEFT"/>+ log_dir: str<BR ALIGN="LEFT"/>+ net_interface: str<BR ALIGN="LEFT"/>+ drive/wlan/bt_refresh_s: int<BR ALIGN="LEFT"/>+ check_updates_on_start: bool<BR ALIGN="LEFT"/>+ process_interval_s: float<BR ALIGN="LEFT"/>+ overlay_enabled/_click_through/<BR ALIGN="LEFT"/>   _hide_main: bool<BR ALIGN="LEFT"/>+ overlay_position, _hotkey: str<BR ALIGN="LEFT"/>+ overlay_alpha: float<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ load(path): Config  <I>{static}</I><BR ALIGN="LEFT"/>+ save(path)<BR ALIGN="LEFT"/>+ validate()<BR ALIGN="LEFT"/>+ thresholds(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    SystemCollector [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>SystemCollector</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ disk_path: str<BR ALIGN="LEFT"/>+ top_n: int<BR ALIGN="LEFT"/>+ cpu_cores: int<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ snapshot(force_processes,<BR ALIGN="LEFT"/>   skip_processes): Snapshot<BR ALIGN="LEFT"/>- _top_processes(): tuple<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    AlertManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>AlertManager</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ thresholds: dict[str, float]<BR ALIGN="LEFT"/>+ cooldown_s: float<BR ALIGN="LEFT"/>+ hysteresis: float<BR ALIGN="LEFT"/>- _active: dict[str, float]<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ check(metrics): list[Alert]<BR ALIGN="LEFT"/>+ update_settings(...)<BR ALIGN="LEFT"/>+ is_active(metric): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    CsvWriter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e8eef7"><B>CsvWriter</B> (storage.py)</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ path: Path<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ write(s: Snapshot)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Snapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>Snapshot</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ timestamp: datetime<BR ALIGN="LEFT"/>+ cpu_percent, ram_percent,<BR ALIGN="LEFT"/>   disk_percent: float<BR ALIGN="LEFT"/>+ ram_/disk_used_gb, _total_gb<BR ALIGN="LEFT"/>+ uptime_s: float<BR ALIGN="LEFT"/>+ processes: tuple[ProcessInfo]<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ metrics(): dict[str, float]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    ProcessInfo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>ProcessInfo</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ pid: int<BR ALIGN="LEFT"/>+ name: str<BR ALIGN="LEFT"/>+ cpu_percent: float<BR ALIGN="LEFT"/>+ memory_percent: float<BR ALIGN="LEFT"/>+ memory_mb: float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Alert [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>Alert</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ timestamp: datetime<BR ALIGN="LEFT"/>+ metric: str<BR ALIGN="LEFT"/>+ value, threshold: float<BR ALIGN="LEFT"/>+ level: Level<BR ALIGN="LEFT"/></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ message(): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Level [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#eeeeee"><I>«enum»</I> <B>Level</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">WARNUNG<BR ALIGN="LEFT"/>OK<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    // Komposition (gefüllte Raute) = Monitor besitzt die Teile
    edge [dir=back, arrowtail=diamond];
    Monitor -> SystemCollector [label=" 1"];
    Monitor -> AlertManager    [label=" 1"];
    Monitor -> CsvWriter       [label=" 0..1"];
    Snapshot -> ProcessInfo    [label=" 0..*"];
    // Aggregation (leere Raute)
    edge [arrowtail=odiamond];
    Monitor -> Config          [label=" 1"];
    MonitorApp -> Monitor      [label=" 1"];

    // Abhängigkeiten (gestrichelt: «erzeugt» / «nutzt»)
    edge [dir=forward, arrowhead=vee, arrowtail=none, style=dashed];
    SystemCollector -> Snapshot [label=" «erzeugt»"];
    AlertManager -> Alert       [label=" «erzeugt»"];
    Alert -> Level              [label=" «nutzt»"];
    MonitorApp -> SettingsDialog [label=" «öffnet»"];
    cli -> Monitor              [label=" «nutzt»"];

    {rank=same; MonitorApp; cli}

    // ---------------- Erweiterungen (Laufwerke, Netzwerk, Bluetooth, Updates)
    DriveScanner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef7"><B>DriveScanner</B> (drives.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">- _bus: dict[str, str]<BR ALIGN="LEFT"/>- _known: set[str]<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ scan(): list[DriveInfo]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    DriveInfo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>DriveInfo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ mountpoint, fstype, bus: str<BR ALIGN="LEFT"/>+ external: bool<BR ALIGN="LEFT"/>+ total_gb, used_gb, free_gb: float<BR ALIGN="LEFT"/>+ percent: float<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ kind: str  {property}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TrafficMeter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef7"><B>TrafficMeter</B> (network.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">+ history: deque[(down, up)]<BR ALIGN="LEFT"/>- _nic: str<BR ALIGN="LEFT"/>- _last: (Zeit, recv, sent)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ interfaces(): list[str]<BR ALIGN="LEFT"/>+ guess_wlan(preferred): str<BR ALIGN="LEFT"/>+ busiest(): str<BR ALIGN="LEFT"/>+ sample(nic): TrafficSample<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    TrafficSample [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>TrafficSample</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ nic: str<BR ALIGN="LEFT"/>+ down_bps, up_bps: float<BR ALIGN="LEFT"/>+ total_down, total_up: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    WlanStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>WlanStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ interfaces: list[WlanInfo]<BR ALIGN="LEFT"/>+ message: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    WlanInfo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>WlanInfo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ name, description, state: str<BR ALIGN="LEFT"/>+ ssid: str<BR ALIGN="LEFT"/>+ signal: int | None<BR ALIGN="LEFT"/>+ radio, band, channel: str<BR ALIGN="LEFT"/>+ rx_mbit, tx_mbit, auth: str<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ connected: bool  {property}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BluetoothStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>BluetoothStatus</B> (bluetooth.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">+ adapters: list[(Name, Status)]<BR ALIGN="LEFT"/>+ devices: list[BtDevice]<BR ALIGN="LEFT"/>+ message: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BtDevice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>BtDevice</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ name, kind, status: str<BR ALIGN="LEFT"/>+ connected: bool | None<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ connection_text: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    UpdateResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>UpdateResult</B> (updates.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">+ updates: list[UpdateInfo]<BR ALIGN="LEFT"/>+ message: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    UpdateInfo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><I>«dataclass»</I> <B>UpdateInfo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ name, package_id: str<BR ALIGN="LEFT"/>+ installed, available: str<BR ALIGN="LEFT"/>+ source: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    BackgroundRunner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef7"><B>BackgroundRunner</B> (tasks.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">- _results: Queue<BR ALIGN="LEFT"/>- _running: set[str]<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ submit(key, func, on_done): bool<BR ALIGN="LEFT"/>+ poll(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    winutil [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«Modul»</I> <B>winutil</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ run_command(args, timeout): CommandResult<BR ALIGN="LEFT"/>+ run_powershell_json(script)<BR ALIGN="LEFT"/>+ decode_output(bytes): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    Abfragefunktionen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«Modul-Funktionen»</I> <B>Abfragefunktionen</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ get_wlan_status(): WlanStatus<BR ALIGN="LEFT"/>+ get_bluetooth_status(): BluetoothStatus<BR ALIGN="LEFT"/>+ list_updates(): UpdateResult<BR ALIGN="LEFT"/>+ start_upgrade(ids)<BR ALIGN="LEFT"/>+ parse_netsh_interfaces(text)<BR ALIGN="LEFT"/>+ parse_winget_upgrade(text)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    edge [dir=back, arrowtail=diamond, style=solid, arrowhead=none];
    MonitorApp -> DriveScanner     [label=" 1"];
    MonitorApp -> TrafficMeter     [label=" 1"];
    MonitorApp -> BackgroundRunner [label=" 1"];
    WlanStatus -> WlanInfo         [label=" 0..*"];
    BluetoothStatus -> BtDevice    [label=" 0..*"];
    UpdateResult -> UpdateInfo     [label=" 0..*"];
    edge [dir=forward, arrowhead=vee, arrowtail=none, style=dashed];
    DriveScanner -> DriveInfo      [label=" «erzeugt»"];
    TrafficMeter -> TrafficSample  [label=" «erzeugt»"];
    MonitorApp -> Abfragefunktionen [label=" «ruft im Hintergrund auf»"];
    Abfragefunktionen -> WlanStatus [label=" «erzeugt»"];
    Abfragefunktionen -> BluetoothStatus [label=" «erzeugt»"];
    Abfragefunktionen -> UpdateResult [label=" «erzeugt»"];
    Abfragefunktionen -> winutil   [label=" «nutzt»"];
    DriveScanner -> winutil        [label=" «nutzt»"];

    // ---------------- Overlay (Version 2.2)
    OverlayWindow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef7"><B>OverlayWindow</B> (overlay.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">+ visible: bool<BR ALIGN="LEFT"/>- top: Toplevel<BR ALIGN="LEFT"/>- label: Label<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ show() / hide()<BR ALIGN="LEFT"/>+ update(text, color)<BR ALIGN="LEFT"/>+ apply_config(config)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    HotkeyListener [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef7"><B>HotkeyListener</B> (overlay.py)</TD></TR><HR/><TR><TD ALIGN="LEFT">+ hotkey: str<BR ALIGN="LEFT"/>+ registered: bool<BR ALIGN="LEFT"/>- events: Queue<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ start(): bool<BR ALIGN="LEFT"/>+ stop()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    overlay_logic [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«Modul»</I> <B>overlay_logic</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ overlay_geometry(...): (x, y)<BR ALIGN="LEFT"/>+ format_overlay_text(...): str<BR ALIGN="LEFT"/>+ level_for(value, threshold): str<BR ALIGN="LEFT"/>+ parse_hotkey(text): (mods, vk)<BR ALIGN="LEFT"/>+ normalize_hotkey(text): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    edge [dir=back, arrowtail=diamond, style=solid, arrowhead=none];
    MonitorApp -> OverlayWindow    [label=" 0..1"];
    MonitorApp -> HotkeyListener   [label=" 1"];
    edge [dir=forward, arrowhead=vee, arrowtail=none, style=dashed];
    OverlayWindow -> overlay_logic [label=" «nutzt»"];
    HotkeyListener -> overlay_logic [label=" «nutzt»"];
    Config -> overlay_logic        [label=" «prüft mit»"];
}
